# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/fitplan?schema=public"

# NextAuth
NEXTAUTH_SECRET="change-this-to-a-random-string-in-production"
NEXTAUTH_URL="http://localhost:3000"

# OpenRouter API
OPENROUTER_API_KEY=""

# ExerciseDB API (RapidAPI)
EXERCISEDB_API_KEY=""

# Web Push (VAPID keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Admin account (seeded on boot / npm run seed:admin)
ADMIN_EMAIL="admin@strive.app"
ADMIN_PASSWORD="change-me-strong-password"
ADMIN_NAME="Strive Admin"

# Google Fit / Health OAuth (optional — step sync)
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:3000/api/google-health/callback
